<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/habit_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <View
        android:id="@+id/vDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:background="@drawable/circle_dot" />

    <TextView
        android:id="@+id/tvHabitName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textColor="@color/mp_text_primary"
        android:textSize="15sp"
        tools:text="Drink Water" />

    <TextView
        android:id="@+id/tvStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/mp_text_secondary"
        android:textSize="12sp"
        tools:text="3\uD83D\uDD25" />

</LinearLayout>