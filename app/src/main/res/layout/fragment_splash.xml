<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mp_background">

    <!-- Splash Content Root Container (Initially Hidden, Fades in when video completes) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/splashContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.0">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/mp_logo"
            app:layout_constraintBottom_toTopOf="@id/tvWordmark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.42"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.08"
            android:text="@string/app_name_wordmark"
            android:textColor="@color/mp_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/vLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivLogo" />

        <View
            android:id="@+id/vLine"
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/gradient_header"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvWordmark" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fullscreen Video View Player Overlaid on Top -->
    <VideoView
        android:id="@+id/introVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>