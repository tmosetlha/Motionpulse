<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.github.com/apk/res/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/habit_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivHabitIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_pulse_line"
        android:contentDescription="Habit Status Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHabitName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/mp_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Drink water" />

        <TextView
            android:id="@+id/tvHabitStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mp_text_secondary"
            android:textSize="13sp"
            tools:text="Logged 5 mins ago" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_button"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/label_plus_badge"
        android:textColor="@color/mp_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>